# Generate a unique random value for each agent. Never reuse these values.
ARIA_TOKEN=replace-with-a-long-random-secret
NOVA_TOKEN=replace-with-a-long-random-secret
ATLAS_TOKEN=replace-with-a-long-random-secret
ECHO_TOKEN=replace-with-a-long-random-secret

PORT=8787
GOOGLE_HOME_MCP_URL=https://home.googleapis.com/mcp

# Supply a short-lived OAuth access token only on the server.
# Do not commit a real token or put it in the Android app.
GOOGLE_HOME_ACCESS_TOKEN=
