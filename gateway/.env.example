# Generate unique random values. Never commit real secrets.
ARIA_TOKEN=replace-with-a-unique-random-secret-at-least-32-characters
NOVA_TOKEN=replace-with-a-unique-random-secret-at-least-32-characters
ATLAS_TOKEN=replace-with-a-unique-random-secret-at-least-32-characters
ECHO_TOKEN=replace-with-a-unique-random-secret-at-least-32-characters
HOME_ADMIN_TOKEN=replace-with-a-separate-random-secret-at-least-32-characters

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match the authorized redirect URI configured in Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_PUBLIC_GATEWAY_HOST/oauth/google/callback

# Generate with: openssl rand -hex 32
HOME_TOKEN_ENCRYPTION_KEY=
GOOGLE_HOME_MCP_URL=https://home.googleapis.com/mcp
MCP_PROTOCOL_VERSION=2025-03-26

PORT=8787
HOST=127.0.0.1
GOOGLE_HOME_TOKEN_FILE=./data/google-home-token.enc
